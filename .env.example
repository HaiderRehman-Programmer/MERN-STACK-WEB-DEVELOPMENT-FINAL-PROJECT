# --- SERVER CONFIG ---
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here_min_10_chars

# --- DATABASE (MongoDB) ---
DATABASE_URL=mongodb://localhost:27017/lms_project

# --- SEARCH (MEILISEARCH) - Optional ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_key_here

# --- PAYMENTS (STRIPE) - Optional for dev ---
STRIPE_SECRET_KEY=sk_test_...
