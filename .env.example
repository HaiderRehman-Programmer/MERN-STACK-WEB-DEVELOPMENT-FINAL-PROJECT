# --- EMAIL (SMTP) - Optional for dev ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_user
SMTP_PASS=your_password

# --- CLIENT URL ---
CLIENT_URL=http://localhost:5173
